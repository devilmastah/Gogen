# --- Binaries ---
/gogen
/gogen-nocgo
/gogenold
/gogen-debug
/gogen-test
/gogen_test

# Test binaries produced by `go test -c` (e.g. agent.test)
*.test

# --- Profiling data ---
*.prof

# --- Scratch patch files ---
*.patch

# --- Snapshot files ---
*.fxsnapshot

# --- Diff scratch files ---
.diff_output.txt

# --- Markdown docs ---
# Not tracked for now: planning / review docs are scratch. Already-tracked
# markdown (README.md, vendored READMEs and licenses) is unaffected.
*.md

# --- Scratch work ---
# tmp/ holds ad-hoc probes and repro scripts; not part of the module surface.
/tmp/

# --- Project configuration ---
# .gogen/ holds local runtime state (config, models cache, sessions, board,
# web_token, …); not tracked.
/.gogen/

# --- Editor / IDE ---
*.swp
*.swo
*~

# --- JS tooling (web UI lint) ---
node_modules/
